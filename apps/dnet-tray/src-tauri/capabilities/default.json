{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the window may do: give the commands in build.rs, and listen for the Rust side's events. Nothing else: no shell, no file system, no network, no other plugin.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-capabilities",
    "allow-snapshot",
    "allow-activity-backlog",
    "allow-stabilize",
    "allow-list-endpoints",
    "allow-add-endpoint",
    "allow-remove-endpoint",
    "allow-prepare-server",
    "allow-finish-server",
    "allow-request-join",
    "allow-accept-invite",
    "allow-prepare-device",
    "allow-finish-device",
    "allow-set-endpoint-enabled",
    "allow-list-profiles",
    "allow-list-components",
    "allow-set-brutal",
    "allow-list-rules",
    "allow-add-rule",
    "allow-remove-rule",
    "allow-list-pending",
    "allow-reject-change",
    "allow-approve-change",
    "allow-set-encrypted-dns",
    "allow-get-guard",
    "allow-set-kill-switch",
    "allow-release-guard",
    "allow-check-updates",
    "allow-open-login-page",
    "allow-window-minimize",
    "allow-window-toggle-maximize",
    "allow-window-start-drag",
    "allow-window-close",
    "allow-window-ready"
  ]
}
