# =============================================================================
# DNet Engine
#
# Tracked: Rust/TS source, configuration, Cargo.lock, ADRs, specs, licence
# texts, and generated BUILD-PROVENANCE.md files.
#
# Not tracked: build output, fetched or built third-party binaries, secrets,
# and local runtime state.
# =============================================================================

# ---------- Rust build output ----------
/target/
**/target/
**/*.rs.bk
*.pdb

# Cargo.lock IS tracked: this workspace produces binaries, so builds must be
# reproducible. (It would be ignored only for a library-only crate.)
!Cargo.lock

# ---------- Python bytecode (harness scripts, tooling) ----------
__pycache__/
*.py[cod]
*$py.class

# ---------- Coverage and test artifacts ----------
*.profraw
*.profdata
/coverage/
/lcov.info
llvm-cov-target/

# ---------- Node / Tauri (Phase 9) ----------
node_modules/
dist/
.pnpm-store/
apps/dnet-tray/src-tauri/target/
apps/dnet-tray/src-tauri/gen/

# ---------- Vendored third-party artifacts ----------
# Binaries are produced by `cargo xtask fetch-vendor` (downloaded for Wintun,
# built from pinned source for the two transport cores). They are never
# committed: they bloat history, and their provenance is recorded instead.
vendor/**/*.exe
vendor/**/*.dll
vendor/**/*.sys
vendor/**/*.so
vendor/**/*.dylib
vendor/**/*.a
vendor/**/*.lib
vendor/**/*.zip
vendor/**/*.tar.gz
vendor/**/*.tgz
vendor/**/*.msi

# Transient source checkouts made while building the cores.
vendor/**/.src/
vendor/**/.download/

# ...but licence texts, provenance, and READMEs under vendor/ ARE tracked.
# These satisfy the GPLv3 §6 source offer and the attribution obligations.
!vendor/**/LICENSE
!vendor/**/LICENSE.*
!vendor/**/COPYING*
!vendor/**/NOTICE*
!vendor/**/BUILD-PROVENANCE.md
!vendor/**/README.md

# ---------- Secrets and environment ----------
# Nothing here should ever reach the repository. Cloud API signing keys in
# particular are stored under DPAPI at runtime, never on disk in the tree
# (see contracts/provisioning.md PR-03, PR-04).
.env
.env.*
!.env.example
*.pem
*.key
!vendor/**/*.key
*.p12
*.pfx
*.oci
oci_api_key*
config.local.*
# Named by data format, not `secrets.*`: that would also hide a source file called secrets.rs.
secrets.json
secrets.toml
secrets.yaml
secrets.yml
secrets.env
secrets.txt

# ---------- Local runtime state ----------
# dnetd writes generated core configuration and undo records here at runtime.
/run/
*.log
logs/

# ---------- Test harness runtime state (Phase 2) ----------
testing/harness/.state/
testing/harness/**/*.pcap
testing/harness/**/captures/

# ---------- Documents ----------
# Prose lives in markdown so it diffs. Binary office formats do not.
docs/**/*.docx
docs/**/*.pdf
docs/**/*.pptx

# ---------- OS / editor ----------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
# Contents, not the directory: git cannot re-include a file whose parent directory is excluded.
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~

# ---------- SPIKE-R4 live-gate output (packet captures, run logs) ----------
testing/spike-r4/results/
# The WSL lab's saved routing state and the client parameters it exports (test keys only).
testing/spike-r4/wsl-lab-*
# The lab's log, and the previous run's copy, which names the account that ran it.
testing/spike-r4/wsl-lab.log*

# ---------- AI assistant files: local tooling, not part of the project ----------
# Skills, agent instructions and workflow scaffolding used while working on the project with an AI
# assistant. They are for whoever works on it locally, not for the product, so they are not
# published. The directory a skill lives in and the rules a person gives the assistant are theirs.
.claude/
CLAUDE.md
CLAUDE.local.md
.claudeignore
.mcp.json

# Spec Kit scaffolding (templates, scripts, workflow definitions, tool manifests) is tooling and
# stays local. The constitution is different: it is the project's governing document, and code,
# CI messages, docs and specs refer to it by this path, so it is published.
.specify/*
!.specify/memory/
.specify/memory/*
!.specify/memory/constitution.md

# Generated by graphify; rebuilt locally with `graphify update .`
graphify-out/

# ---------- Local tool caches and lab artefacts ----------
.ruff_cache/
.pytest_cache/
.mypy_cache/
# The WSL image export and launcher the T055 lab uses (large, machine-specific).
.t055-wsl/
